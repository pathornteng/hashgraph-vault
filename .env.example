# Hedera operator account (fee payer)
OPERATOR_ID=0.0.YOUR_ACCOUNT_ID

# Operator signing — set ONE of these:
# Option A: raw hex private key (with or without 0x prefix)
OPERATOR_PRIVATE_KEY=your-hex-private-key
# Option B: name of a Vault Transit key that controls the operator account
# OPERATOR_VAULT_KEY=operator-key

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-256bit-secret
JWT_EXPIRY=8h
