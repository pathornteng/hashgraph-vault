# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# Hedera
HEDERA_NETWORK=testnet
OPERATOR_ID=0.0.XXXXXX

# Operator signing — choose ONE:
# Option A: existing Hedera account with a known private key (hex, with or without 0x prefix)
OPERATOR_PRIVATE_KEY=your-ed25519-private-key-hex
# Option B: operator key is managed by Vault Transit (key must already exist in Vault)
# OPERATOR_VAULT_KEY=operator-key

# Server
PORT=4000
NODE_ENV=development
ADMIN_TOKEN=changeme
